# Copy to .env for local testing. NEVER commit .env.
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_USER_ID=your-discord-user-id-here
# Not secret (Discord shows these publicly in the Developer Portal), but
# recorded here for reference. The Worker will read its own copies from
# wrangler config, not this file.
DISCORD_PUBLIC_KEY=your-app-public-key-here
DISCORD_APPLICATION_ID=your-app-id-here
# Bělá 87, 747 23 Bělá (Opava district) — defaults already in code
LAT=49.97233
LON=18.14489
TZ_NAME=Europe/Prague
WORK_START=11
WORK_END=20
# Neon Postgres connection string (SECRET — from Neon dashboard, rotate if ever exposed)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
